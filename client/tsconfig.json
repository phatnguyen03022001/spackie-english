{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
    },
    "rootDirs": ["."],
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "types/**/*.d.ts",
    "**/*.css",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "postcss.config.mjs", "features/vocabulary/hooks/use-sm2-logic.ts", "features/vocabulary/components/learning/xtra-study-modal.tsx ", "features/dashboard/components/export const AppHeader = ({ role, pathSegments }: DashboardHeaderProps) => {",  
  ],
  "exclude": ["node_modules"]
}
