// ============================================================
// Prisma Schema – Spackie English (Global Vocabulary + Parroto)
// DB      : MongoDB Atlas (M0+)
// Version : 10/10 – Nâng cấp tối ưu chi phí & Anki-like
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum DeckVisibility {
  PRIVATE
  PUBLIC
}

enum CardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum FileRefType {
  AVATAR
  CARD_IMAGE
  CARD_AUDIO
  DECK_COVER
}

enum ListeningType {
  REPEAT
  DICTATION
  COMPREHENSION
  YOUTUBE_SYNC
}

// ─────────────────────────────────────────────
// MODEL: User (giữ nguyên – không thay đổi)
// ─────────────────────────────────────────────

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  username     String  @unique
  passwordHash String?

  role       Role         @default(USER)
  provider   AuthProvider @default(LOCAL)
  providerId String?

  avatarUrl   String?
  displayName String?
  isActive    Boolean @default(true)
  isVerified  Boolean @default(false)
  isBanned    Boolean @default(false)

  settings Json @default("{}")

  totalCardsLearned Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastStudiedAt     DateTime?

  subscription       Subscription?
  payments           Payment[]
  decks              Deck[]
  cardProgress       CardProgress[]
  files              File[]
  listeningPractices ListeningPractice[]
  adminDevices       AdminDevice[]

  twoFactorSecret  String? // encrypted AES-256-GCM
  twoFactorEnabled Boolean  @default(false)
  recoveryCodes    String[] @default([])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  notifications  Notification[]
  studySessions  StudySession[]
  aiUsages       AiUsage[]
  auditLogs      AuditLog[]
  createdReports Report[]       @relation("reporter")
  userFavorites  UserFavorite[]
  userActivities UserActivity[]

  @@index([provider, providerId])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// MODEL: Subscription (giữ nguyên)
// ─────────────────────────────────────────────

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    SubscriptionStatus @default(EXPIRED)
  plan      String             @default("monthly")
  startedAt DateTime?
  expiresAt DateTime?

  meta Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// MODEL: Payment (giữ nguyên)
// ─────────────────────────────────────────────

model Payment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderCode   String        @unique
  amount      Int
  currency    String        @default("VND")
  description String?
  status      PaymentStatus @default(PENDING)
  provider    String        @default("payos")

  plan         String
  durationDays Int

  paidAt DateTime?
  meta   Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────
// MODEL: File (giữ nguyên)
// ─────────────────────────────────────────────

model File {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url          String
  publicId     String       @unique
  resourceType String
  mimeType     String
  sizeBytes    Int
  refType      FileRefType?
  refId        String?      @db.ObjectId

  meta Json @default("{}")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([refType, refId])
  @@map("files")
}

// ─────────────────────────────────────────────
// MODEL: AdminDevice (giữ nguyên)
// ─────────────────────────────────────────────

model AdminDevice {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  deviceId   String
  deviceName String?
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@map("admin_devices")
}

// ─────────────────────────────────────────────
// MODEL: Otp (giữ nguyên)
// ─────────────────────────────────────────────

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otpHash   String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otps")
}

// ─────────────────────────────────────────────
// MODEL: Deck (cập nhật – dùng mapping)
// ─────────────────────────────────────────────

model Deck {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  coverUrl    String?
  visibility  DeckVisibility @default(PRIVATE)
  tags        String[]       @default([])
  isVipOnly   Boolean        @default(false)

  totalCards Int @default(0)

  cardMappings DeckCardMapping[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  userFavorites UserFavorite[]

  @@index([userId])
  @@index([visibility])
  @@index([tags])
  @@index([deletedAt])
  @@map("decks")
}

// ─────────────────────────────────────────────
// MODEL: GlobalCard (MỚI – kho từ vựng dùng chung)
// ─────────────────────────────────────────────

model GlobalCard {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  front    String  @unique
  back     String?
  imageUrl String?
  audioUrl String?

  extras Json @default("{}") // pronunciation, pos, examples, hint...

  status       String  @default("pending") // pending, meaning_ready, completed, partial, failed
  errorMessage String?

  validated       Boolean  @default(false) // true after validation check
  valid           Boolean? // null = unknown, true = valid, false = invalid
  validationError String?

  deckMappings       DeckCardMapping[]
  cardProgress       CardProgress[]
  listeningPractices ListeningPractice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("global_cards")
}

// ─────────────────────────────────────────────
// MODEL: DeckCardMapping (MỚI – liên kết Deck ↔ GlobalCard)
// ─────────────────────────────────────────────

model DeckCardMapping {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  deckId String @db.ObjectId
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  globalCardId String     @db.ObjectId
  globalCard   GlobalCard @relation(fields: [globalCardId], references: [id], onDelete: Cascade)

  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())

  @@unique([deckId, globalCardId])
  @@index([deckId])
  @@index([globalCardId])
  @@map("deck_card_mappings")
}

// ─────────────────────────────────────────────
// MODEL: CardProgress (cập nhật – gắn với GlobalCard, độc lập Deck)
// ─────────────────────────────────────────────

model CardProgress {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  globalCardId String     @db.ObjectId
  globalCard   GlobalCard @relation(fields: [globalCardId], references: [id], onDelete: Cascade)

  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)
  dueDate     DateTime @default(now())

  lastRating  CardRating?
  reviewCount Int         @default(0)

  recentReviews Json[] @default([])

  firstSeenAt  DateTime  @default(now())
  lastReviewAt DateTime?

  @@unique([userId, globalCardId])
  @@index([userId, dueDate])
  @@index([globalCardId])
  @@map("card_progress")
}

// ─────────────────────────────────────────────
// MODEL: Notification (MỚI – in-app notifications)
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "system", "study_reminder", "achievement", "payment"
  title     String
  body      String
  data      Json     @default("{}") // extra metadata
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// MODEL: StudySession (MỚI – study time tracking)
// ─────────────────────────────────────────────

model StudySession {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  totalCardsReviewed Int       @default(0)
  totalDurationMs    Int       @default(0) // milliseconds
  createdAt          DateTime  @default(now())

  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ─────────────────────────────────────────────
// MODEL: AiUsage (MỚI – AI usage tracking)
// ─────────────────────────────────────────────

model AiUsage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation    String // "meaning", "validation", "hint", "tts"
  inputTokens  Int
  outputTokens Int
  cost         Float // in USD cents
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usages")
}

// ─────────────────────────────────────────────
// MODEL: AuditLog (MỚI – ghi lại hành động hệ thống)
// ─────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String  @db.ObjectId
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action   String // LOGIN, LOGOUT, CHANGE_ROLE, BAN, UNBAN, DELETE_USER, PAYMENT_SUCCESS, REFUND, DECK_DELETE, CARD_DELETE, ...
  targetId String? // ID của đối tượng bị tác động
  details  Json    @default("{}") // IP, userAgent, oldValue, newValue, ...

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// MODEL: Report (MỚI – báo cáo vi phạm nội dung)
// ─────────────────────────────────────────────

model Report {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  reporterId  String    @db.ObjectId
  reporter    User      @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String // "DECK", "CARD", "USER"
  targetId    String
  reason      String // SPAM, OFFENSIVE, COPYRIGHT, OTHER
  description String?
  status      String    @default("PENDING") // PENDING, RESOLVED, REJECTED
  resolvedBy  String?   @db.ObjectId
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// ─────────────────────────────────────────────
// MODEL: UserFavorite (MỚI – bookmark deck)
// ─────────────────────────────────────────────

model UserFavorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId    String   @db.ObjectId
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, deckId])
  @@map("user_favorites")
}

// ─────────────────────────────────────────────
// MODEL: UserActivity (MỚI – ghi lại hoạt động user)
// ─────────────────────────────────────────────

model UserActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VIEW_DECK, CREATE_CARD, REVIEW_CARD, LISTENING, EXPORT_DECK, ...
  targetId  String? // deckId, cardId, ...
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_activities")
}

// ─────────────────────────────────────────────
// MODEL: ListeningPractice (cập nhật – hỗ trợ YouTube)
// ─────────────────────────────────────────────

model ListeningPractice {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  globalCardId String?     @db.ObjectId
  globalCard   GlobalCard? @relation(fields: [globalCardId], references: [id])

  type     ListeningType @default(REPEAT)
  score    Float
  fluency  Float?
  accuracy Float?
  duration Int // milliseconds

  // YouTube Parroto fields
  youtubeId String?
  startTime Float?
  endTime   Float?

  result Json @default("{}") // transcript, expectedText, wordErrors, etc.

  createdAt DateTime @default(now())

  @@index([userId, globalCardId])
  @@index([userId, youtubeId])
  @@index([type])
  @@map("listening_practices")
}
