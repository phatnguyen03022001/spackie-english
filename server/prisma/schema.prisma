datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  email      String      @unique
  password   String
  isVerified Boolean     @default(false)
  name       String?
  role       UserRole    @default(STUDENT)
  decks      Deck[]
  flashcards Flashcard[]
  createdAt  DateTime    @default(now())
}

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  type      String
  expiresAt DateTime

  @@unique([email, type])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model Deck {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isPublic    Boolean     @default(false)
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id])
  flashcards  Flashcard[]
  createdAt   DateTime    @default(now())
}

model Flashcard {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  word     String // Từ vựng (Ví dụ: "hello")
  phonetic String? // Phiên âm
  audioUrl String? // Link file nghe từ API

  // Dữ liệu từ Dictionary API thường rất dài, ta lưu dạng JSON hoặc Type
  meanings Meaning[]

  // Quan hệ
  userId String  @db.ObjectId
  user   User    @relation(fields: [userId], references: [id])
  deckId String? @db.ObjectId
  deck   Deck?   @relation(fields: [deckId], references: [id])

  // Logic Anki (SM-2 Algorithm)
  interval   Int      @default(0) // Khoảng cách ngày ôn tập tiếp theo
  repetition Int      @default(0) // Số lần đã ôn tập thành công liên tiếp
  easeFactor Float    @default(2.5) // Độ dễ của thẻ (mặc định 2.5)
  nextReview DateTime @default(now()) // Thời điểm cần học lại

  status    CardStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([userId, nextReview]) // Optimize query lấy từ cần học hôm nay
}

type Meaning {
  partOfSpeech String // noun, verb, adjective...
  definitions  Definition[]
}

type Definition {
  definition String
  example    String?
  synonyms   String[]
  antonyms   String[]
}

enum CardStatus {
  NEW
  LEARNING
  REVIEW
  LAPSED
}
