datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Với MongoDB, relationMode mặc định là "prisma" → emulate referential integrity ở client-side
// Không hỗ trợ onDelete: SetNull trên required fields, không hỗ trợ đầy đủ referential actions như SQL

/**
 * =========================
 * ENUMS
 * =========================
 */

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum CardStatus {
  NEW
  LEARNING
  REVIEW
  LAPSED
}

enum OTPType {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
}

/**
 * =========================
 * USER (auth + progress)
 * =========================
 */

model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  email    String   @unique
  password String
  role     UserRole @default(STUDENT)
  name     String?

  isVerified Boolean @default(false)

  vocabXp    Int       @default(0)
  streak     Int       @default(0)
  lastActive DateTime?

  decks Deck[]
  cards Card[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

/**
 * =========================
 * DECK
 * =========================
 */

model Deck {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isPublic    Boolean @default(false)
  levelTag    String?

  creatorId String @db.ObjectId
  creator   User   @relation(fields: [creatorId], references: [id])

  cards Card[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([creatorId]) // Lấy decks của teacher/admin
  @@index([isPublic]) // Lọc public decks
  @@index([levelTag]) // Lọc theo level (nếu dùng)
}

/**
 * =========================
 * CARD (ANKI CORE)
 * =========================
 */

model Card {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  word     String
  phonetic String?
  audioUrl String?

  meanings Meaning[]

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  deckId String? @db.ObjectId
  deck   Deck?   @relation(fields: [deckId], references: [id])

  status     CardStatus @default(NEW)
  interval   Int        @default(0)
  repetition Int        @default(0)
  easeFactor Float      @default(2.5)
  nextReview DateTime   @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([userId, word]) // Ngăn duplicate từ vựng của cùng user
  @@index([userId, nextReview]) // Core SRS: lấy card cần review
  @@index([userId, deckId]) // Cards theo deck của user
  @@index([deckId]) // Tất cả cards trong deck
  @@index([userId, status]) // Lọc theo trạng thái học
}

/**
 * =========================
 * OTP (One-Time Password)
 * =========================
 */

model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  type      OTPType
  expiresAt DateTime
  used      Boolean  @default(false)

  @@unique([email, type], name: "email_type_unique")
  @@index([email])
  @@index([expiresAt]) // Dễ query dọn dẹp OTP hết hạn
}

/**
 * =========================
 * EMBEDDED TYPES
 * =========================
 */

type Meaning {
  partOfSpeech String
  definitions  Definition[]
}

type Definition {
  definition String
  example    String?
  synonyms   String[]
  antonyms   String[]
}
