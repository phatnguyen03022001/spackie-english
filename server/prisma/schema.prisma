datasource db {
  provider = "mongodb"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../shared/generated/prisma-client"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  email       String         @unique
  name        String?
  role        String
  progress    UserProgress[]
  flashcards  Flashcard[]
  testResults TestResult[]
  createdAt   DateTime       @default(now())
}

model Flashcard {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  word       String
  definition String
  example    String?
  audioUrl   String?
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  interval   Int      @default(0)
  repetition Int      @default(0)
  easeFactor Float    @default(2.5)
  nextReview DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model ListeningLesson {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  audioUrl   String
  transcript Transcript[]
  level      String
  category   String
  questions  Question[]
}

type Transcript {
  time        Float
  text        String
  translation String?
}

model Exam {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  type     ExamType
  duration Int
  sections Section[]
}

enum ExamType {
  TOEIC
  IELTS
}

type Section {
  title     String
  questions Question[]
}

type Question {
  order         Int
  content       String?
  imagePath     String?
  audioPath     String?
  passage       String?
  options       String[]
  correctAnswer String
  explanation   String?
}

model TestResult {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  examId    String       @db.ObjectId
  score     Float
  answers   UserAnswer[]
  createdAt DateTime     @default(now())
}

type UserAnswer {
  questionOrder Int
  selected      String
  isCorrect     Boolean
}

model UserProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
  wordsLearnt Int      @default(0)
  listenTime  Int      @default(0)
}
