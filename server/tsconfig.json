{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node", "multer"],
    "declaration": true,
    "sourceMap": true,
    "incremental": false
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma/generated"]
}
