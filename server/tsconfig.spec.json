{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["jest", "node", "multer", "express"],
    "isolatedModules": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "coverage", "prisma/generated"]
}
