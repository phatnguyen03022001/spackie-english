datasource db {
  provider = "mongodb"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../shared/generated/prisma-client"
}

// --- NGƯỜI DÙNG ---
model User {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  email       String         @unique
  name        String?
  progress    UserProgress[]
  flashcards  Flashcard[]
  testResults TestResult[]
  createdAt   DateTime       @default(now())
}

// --- TỪ VỰNG (ANKI STYLE) ---
model Flashcard {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  word       String
  definition String
  example    String?
  audioUrl   String?
  userId     String  @db.ObjectId
  user       User    @relation(fields: [userId], references: [id])

  // Thuật toán SM-2
  interval   Int      @default(0)
  repetition Int      @default(0)
  easeFactor Float    @default(2.5)
  nextReview DateTime @default(now())

  createdAt DateTime @default(now())
}

// --- LUYỆN NGHE (PAROTO STYLE) ---
model ListeningLesson {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  audioUrl   String
  transcript Transcript[] // Nhúng trực tiếp mảng transcript vào lesson
  level      String
  category   String
  questions  Question[] // Nhúng mảng câu hỏi kiểm tra ngắn
}

// Kiểu dữ liệu nhúng (Embedded Type)
type Transcript {
  time        Float
  text        String
  translation String?
}

// --- LUYỆN ĐỀ (TOEIC / IELTS) ---
model Exam {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  type     ExamType
  duration Int
  sections Section[] // Với MongoDB, nhúng Section vào Exam sẽ giúp truy vấn nhanh hơn rất nhiều
}

enum ExamType {
  TOEIC
  IELTS
}

type Section {
  title     String
  questions Question[] // Nhúng toàn bộ câu hỏi vào Section
}

type Question {
  order         Int
  content       String?
  imagePath     String?
  audioPath     String?
  passage       String?
  options       String[] // MongoDB lưu mảng String trực tiếp rất tốt
  correctAnswer String
  explanation   String?
}

// --- KẾT QUẢ VÀ TIẾN ĐỘ ---
model TestResult {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  examId    String       @db.ObjectId
  score     Float
  // Lưu chi tiết từng câu user làm để xem lại (Nhúng để tránh query nhiều)
  answers   UserAnswer[]
  createdAt DateTime     @default(now())
}

type UserAnswer {
  questionOrder Int
  selected      String
  isCorrect     Boolean
}

model UserProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
  wordsLearnt Int      @default(0)
  listenTime  Int      @default(0)
}
